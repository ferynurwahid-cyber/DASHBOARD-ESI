<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">
<title>Enviro Strategic Dashboard</title>

<style>

body{
font-family:Arial;
margin:0;
background:#f4f6f9;
}

nav{
background:#1e293b;
padding:15px;
}

nav a{
color:white;
margin-right:20px;
text-decoration:none;
font-weight:bold;
}

.container{
padding:30px;
}

.cards{
display:flex;
gap:20px;
margin-bottom:30px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
width:200px;
box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

table{
width:100%;
background:white;
border-collapse:collapse;
}

th,td{
padding:12px;
border-bottom:1px solid #eee;
}

</style>

</head>

<body>

<nav>
<a href="index.html">Dashboard</a>
<a href="projects.html">Projects</a>
<a href="rfi.html">RFI Tracker</a>
<a href="proposals.html">Proposals</a>
<a href="monitoring.html">Monitoring</a>
<a href="content.html">Content</a>
</nav>

<div class="container">

<h1>Enviro Strategic Dashboard</h1>

<div class="cards">

<div class="card">
<h3>Total Projects</h3>
<p id="totalProjects">0</p>
</div>

<div class="card">
<h3>Total RFI</h3>
<p id="totalRFI">0</p>
</div>

<div class="card">
<h3>Total Proposals</h3>
<p id="totalProposals">0</p>
</div>

</div>

<h2>Project List</h2>

<table>

<thead>
<tr>
<th>Project</th>
<th>Client</th>
<th>Status</th>
</tr>
</thead>

<tbody id="projectTable"></tbody>

</table>

</div>

<script type="module">

import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm"

const supabase = createClient(
"https://fzplvluohnbuggvdqkkw.supabase.co",
"YOUR_SUPABASE_KEY"
)

async function loadDashboard(){

const { data } = await supabase
.from("projects")
.select("*")

document.getElementById("totalProjects").innerText = data.length

let table = document.getElementById("projectTable")

data.forEach(p=>{

table.innerHTML += `
<tr>
<td>${p.project_name ?? ""}</td>
<td>${p.client_name ?? ""}</td>
<td>${p.project_status ?? ""}</td>
</tr>
`

})

}

loadDashboard()

</script>

</body>
</html>
